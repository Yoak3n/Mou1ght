# docker compose 插值模板：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 使用：docker compose -f docker-compose.prod.yaml up -d --build

# 站点公网地址（sitemap / RSS 链接、社交预览用）
SITE_URL=https://your-domain.com

# 镜像命名空间 = 你的 Docker Hub 账号名（compose 的 image 前缀，漏了会去拉 mou1ght/xxx）
DOCKERHUB_USERNAME=your-dockerhub-username
# 可选：固定镜像版本（默认 latest）
# IMAGE_TAG=v1.0.0

# 前台按需失效 webhook 的密钥，需与 config.yaml 的 client.revalidate_secret 一致
REVALIDATE_SECRET=please-change-me

# 后端 JWT 密钥（留空则由后端生成并写回 config.yaml，前提是配置挂载可写）
# 建议用 openssl rand -hex 32 生成并固定
JWT_KEY=
VISITOR_JWT_KEY=

# 独立 PostgreSQL 数据库（compose 里的 db 服务）
POSTGRES_USER=mou1ght
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mou1ght
