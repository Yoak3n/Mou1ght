# 站点公网地址（sitemap / RSS 链接、社交预览用）
SITE_URL=https://your-domain.com

# 镜像版本（默认 latest；发布新版本时固定到 v1.0.0 等）
# IMAGE_TAG=v1.0.0

# 前台按需失效 webhook 的密钥，需与 config.yaml 的 client.revalidate_secret 一致
REVALIDATE_SECRET=please-change-me

# 后端 JWT 密钥（留空则由后端生成并写回 config.yaml，前提是配置挂载可写）
# 建议用 openssl rand -hex 32 生成并固定
JWT_KEY=
VISITOR_JWT_KEY=

# 独立 PostgreSQL 数据库（compose 里的 db 服务）
POSTGRES_USER=mou1ght
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mou1ght
